<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WheelWizard.Views.Converters"
             x:Class="WheelWizard.Views.App"
             Name="Wheel Wizard+"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="DefaultFont">avares://BetterWheelWizard/Resources/Fonts/Roboto-Regular.ttf#Roboto, avares://BetterWheelWizard/Resources/Fonts/ctmkf.ttf#CTMKF</FontFamily>
            <FontFamily x:Key="MiiFont">avares://BetterWheelWizard/Resources/Fonts/ctmkf.ttf#CTMKF, avares://BetterWheelWizard/Resources/Fonts/Roboto-Regular.ttf#Roboto</FontFamily>

            <!-- CONSTANTS -->
            <x:TimeSpan x:Key="ControlAnimationDuration">0:0:0.12</x:TimeSpan>
            <x:TimeSpan x:Key="SegmentAnimationDuration">0:0:0.24</x:TimeSpan>
            <x:Boolean x:Key="ControlAnimationsEnabled">True</x:Boolean>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Styles/Resources/Constants.axaml" />
                <ResourceInclude Source="Styles/Resources/Icons.axaml" />
                <ResourceInclude Source="Styles/Resources/MultiIcons.axaml" />
                <!-- MiiIcons -->
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiHair.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiEye.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiNose.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiEyebrow.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiGlasses.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiMouth.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiFace.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiMustache.axaml" />
                <ResourceInclude Source="Styles/Resources/MiiIcons/MiiGoatee.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- CONVERTERS -->
            <converters:IsEqualToConverter x:Key="IsEqualTo" />
            <ControlTheme x:Key="DesktopWindowDecorations" TargetType="WindowDrawnDecorations"
                          BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
                <Setter Property="Template">
                    <WindowDrawnDecorationsTemplate>
                        <WindowDrawnDecorationsContent>
                            <WindowDrawnDecorationsContent.Underlay>
                                <Panel x:Name="PART_UnderlayWrapper">
                                    <Border x:Name="PART_WindowBorder" Background="Transparent"
                                            BorderThickness="{TemplateBinding FrameThickness}"
                                            BorderBrush="{DynamicResource Neutral600}" IsHitTestVisible="False" />
                                    <Panel x:Name="PART_TitleBar" VerticalAlignment="Top"
                                           Height="{TemplateBinding TitleBarHeight}"
                                           IsVisible="{TemplateBinding HasTitleBar}"
                                            Background="Transparent"
                                           WindowDecorationProperties.ElementRole="TitleBar" />
                                </Panel>
                            </WindowDrawnDecorationsContent.Underlay>
                            <WindowDrawnDecorationsContent.Overlay>
                                <Panel x:Name="PART_OverlayWrapper">
                                    <StackPanel x:Name="PART_OverlayPanel" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                IsVisible="{TemplateBinding HasTitleBar}">
                                        <Button x:Name="PART_MinimizeButton" Theme="{StaticResource FluentDrawnCaptionButton}"
                                                WindowDecorationProperties.ElementRole="MinimizeButton">
                                            <PathIcon Width="11" Height="11" Data="{StaticResource Minimize}"
                                                      Foreground="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                        <Button x:Name="PART_MaximizeButton" Theme="{StaticResource FluentDrawnCaptionButton}"
                                                WindowDecorationProperties.ElementRole="MaximizeButton">
                                            <Viewbox Width="11" Height="11">
                                                <Path x:Name="RestoreButtonPath" Stretch="Uniform"
                                                      Fill="{Binding $parent[Button].Foreground}"
                                                      Data="M2048 2048v-2048h-2048v2048h2048zM1843 1843h-1638v-1638h1638v1638z" />
                                            </Viewbox>
                                        </Button>
                                        <Button x:Name="PART_CloseButton" Theme="{StaticResource FluentDrawnCaptionButton}"
                                                WindowDecorationProperties.ElementRole="CloseButton">
                                            <PathIcon Width="11" Height="11" Data="{StaticResource XMark}"
                                                      Foreground="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                    </StackPanel>
                                </Panel>
                            </WindowDrawnDecorationsContent.Overlay>
                        </WindowDrawnDecorationsContent>
                    </WindowDrawnDecorationsTemplate>
                </Setter>
                <Style Selector="^ /template/ Button">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Neutral400}" />
                </Style>
                <Style Selector="^ /template/ Button:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Neutral600}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Neutral500}" />
                    <Setter Property="Foreground" Value="{DynamicResource Neutral50}" />
                </Style>
                <Style Selector="^ /template/ Button:pressed">
                    <Setter Property="Background" Value="{DynamicResource Neutral700}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Neutral500}" />
                </Style>
                <Style Selector="^ /template/ Button:disabled">
                    <Setter Property="Foreground" Value="{DynamicResource Neutral950}" />
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <!-- A disabled maximize button is invisible but still reserves 30px, leaving a gap between minimize and close. -->
                <Style Selector="^ /template/ Button#PART_MaximizeButton:disabled">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ControlTheme>
            <ControlTheme x:Key="LinuxWindowDecorations" TargetType="WindowDrawnDecorations"
                          BasedOn="{StaticResource DesktopWindowDecorations}">
                <!-- The client fills the window; Linux's drawn frame/shadow would inset only the caption buttons. -->
                <Setter Property="DefaultFrameThickness" Value="0" />
                <Setter Property="DefaultShadowThickness" Value="0" />
                <Style Selector="^:has-border /template/ StackPanel#PART_OverlayPanel">
                    <Setter Property="Margin" Value="0" />
                </Style>
                <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>


    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <Style Selector=":is(Window)">
            <Setter Property="WindowDecorationsTheme"
                    Value="{OnPlatform Default={StaticResource DesktopWindowDecorations}, Linux={StaticResource LinuxWindowDecorations}, macOS={x:Null}}" />
        </Style>
        <!-- !!Only used for the designer!! -->
        <StyleInclude Source="avares://BetterWheelWizard/Views/DesignTime/Controls/MultiColorExampleComponent.axaml" />
        <!-- !!Only used for the designer!! -->

        <!-- STYLES -->
        <StyleInclude Source="Styles/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="Styles/Styles/TextStyles.axaml" />
        <StyleInclude Source="Styles/Styles/MiscStyles.axaml" />
        <StyleInclude Source="Styles/Styles/SliderStyles.axaml" />

        <!-- STANDARD COMPONENTS -->
        <StyleInclude Source="Components/MultiColoredIcon.axaml" />
        <StyleInclude Source="Components/MultiIconRadioButton.axaml" />
        <StyleInclude Source="Components/IconLabel.axaml" />
        <StyleInclude Source="Components/ActionButton.axaml" />
        <StyleInclude Source="Components/SplitButton.axaml" />
        <StyleInclude Source="Components/Toggle.axaml" />
        <StyleInclude Source="Components/Dropdown.axaml" />
        <StyleInclude Source="Components/InputField.axaml" />
        <StyleInclude Source="Components/StatusBadge.axaml" />
        <StyleInclude Source="Components/EmptyPageInfo.axaml" />
        <StyleInclude Source="Components/FormFieldLabel.axaml" />
        <StyleInclude Source="Components/Spinner.axaml" />
        <StyleInclude Source="Components/SegmentedControl.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Views/Shell/Controls/SidebarRadioButton.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Features/WheelWizardData/Views/CommunityCountBadge.axaml" />

        <!-- PAGE/WHWZ SPECIFIC COMPONENTS -->
        <StyleInclude Source="avares://BetterWheelWizard/Features/Mods/Views/ModBrowserListItem.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Features/RrRooms/Views/PlayerListItem.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Features/WheelWizardData/Views/CommunityBadge.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Features/WiiManagement/MiiManagement/Views/MiiBlock.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Views/Shell/Controls/WheelTrail.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Features/WheelWizardData/Views/LeaderboardPodiumStep.axaml" />
        <StyleInclude Source="avares://BetterWheelWizard/Features/MiiImages/Views/MiiPeeker.axaml" />
    </Application.Styles>
</Application>
