<dialogBase:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:components="clr-namespace:WheelWizard.Views.Components"
                   xmlns:loc="clr-namespace:WheelWizard.Localization"
                   xmlns:miiVars="using:WheelWizard.MiiImages.Domain"
                   xmlns:conv="clr-namespace:WheelWizard.Views.Converters"
                   mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="700" ClipToBounds="False"
                   x:Class="WheelWizard.WheelWizardData.Views.Dialogs.PlayerProfileWindow"
                   x:DataType="communityDialogs:PlayerProfileWindow"
        xmlns:miiImages="clr-namespace:WheelWizard.MiiImages.Views"
        xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base"
        xmlns:communityDialogs="clr-namespace:WheelWizard.WheelWizardData.Views.Dialogs">
    <Grid Width="540" MinHeight="400" MaxHeight="760">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20"
                    IsVisible="{Binding IsLoading}">
            <components:Spinner Width="72" Height="72" />
            <TextBlock Text="Loading profile..." Classes="BodyText" FontSize="14" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    IsVisible="{Binding HasError}">
            <PathIcon Data="{StaticResource WarningTriangle}" Width="54" Height="54"
                      Foreground="{StaticResource Danger600}" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="BodyText" FontSize="14" HorizontalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{StaticResource Danger600}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding Profile, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="14" Margin="0,8,0,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border CornerRadius="18" ClipToBounds="True" Background="{DynamicResource Neutral900}"
                            Width="104" Height="104">
                        <miiImages:MiiImageLoader HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                 LoadingColor="{DynamicResource Neutral600}"
                                                 Mii="{Binding DisplayMii}"
                                                 FallBackColor="{DynamicResource Neutral600}"
                                                 ImageVariant="{x:Static miiVars:MiiImageVariants.OnlinePlayerSmall}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding ProfileName}" FontSize="26" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProfileFriendCode}" Classes="BodyText" FontSize="13"
                                   Foreground="{DynamicResource Neutral400}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <TextBlock Text="{Binding LastSeenText, StringFormat='Last seen {0}'}" Classes="TinyText"
                                       VerticalAlignment="Center" />
                            <components:StatusBadge Text="Suspicious" Variant="Error" HorizontalAlignment="Left"
                                                    IsVisible="{Binding IsSuspicious}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="2" Margin="-3,0">
                    <Border Background="{DynamicResource Neutral900}" CornerRadius="12" Padding="6,10" Margin="3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="Rank" Classes="TinyText" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RankText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Neutral900}" CornerRadius="12" Padding="6,10" Margin="3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="VR" Classes="TinyText" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding VrText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="VR change" Classes="TinyText" Margin="2,0,0,-8" />
                <UniformGrid Columns="3" Margin="-3,-6,-3,0">
                    <Border Background="{DynamicResource Neutral900}" CornerRadius="12" Padding="6,10" Margin="3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="24 hours" Classes="TinyText" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Vr24HoursText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding Vr24Brush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Neutral900}" CornerRadius="12" Padding="6,10" Margin="3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="7 days" Classes="TinyText" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding VrWeekText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding VrWeekBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Neutral900}" CornerRadius="12" Padding="6,10" Margin="3">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="30 days" Classes="TinyText" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding VrMonthText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding VrMonthBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="VR history" Classes="TinyText" Margin="2,4,0,-6" />
                <ContentControl x:Name="HistoryHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</dialogBase:PopupContent>
