<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             mc:Ignorable="d" d:DesignWidth="444" d:DesignHeight="716"
             x:Class="WheelWizard.Settings.Views.BackupSettings">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,15,0,0" Spacing="14" MaxWidth="440">
            <StackPanel Spacing="3">
                <components:FormFieldLabel Text="Backup" />
            </StackPanel>

            <StackPanel Spacing="4">
                <!-- rksys.dat -->
                <Border Classes="SettingsBlockStyle SettingsRowStyle SettingsRowTop">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <components:FormFieldLabel Text="Save file (rksys.dat)" />
                            <TextBlock x:Name="RksysStatusText" IsVisible="False" Classes="TinyText" TextWrapping="Wrap" Text="Checking…" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <components:ActionButton x:Name="BackupRksysButton" Tone="Secondary" Size="Compact" Text="Back up"
                                                     Click="BackupRksys_OnClick" />
                            <components:ActionButton x:Name="ImportRksysButton" Tone="Secondary" Size="Compact" Text="Import"
                                                     Click="ImportRksys_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Copies kept automatically before every change to the save. -->
                <Border Classes="SettingsBlockStyle SettingsRowStyle SettingsRowMiddle">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56" ColumnSpacing="16">
                        <components:FormFieldLabel Text="Earlier saves" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <components:ActionButton Tone="Secondary" Size="Compact" Text="Manage"
                                                     ToolTip.Tip="Name an earlier save, delete one, or clear out the old ones"
                                                     Click="ManageBackups_OnClick" />
                            <components:ActionButton Tone="Secondary" Size="Compact" Text="Restore"
                                                     Click="RestoreRksys_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RRRating.pul -->
                <Border Classes="SettingsBlockStyle SettingsRowStyle SettingsRowBottom">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="56" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <components:FormFieldLabel Text="Rating file (RRRating.pul)" />
                            <TextBlock x:Name="RatingStatusText" IsVisible="False" Classes="TinyText" TextWrapping="Wrap" Text="Checking…" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <components:ActionButton x:Name="BackupRatingButton" Tone="Secondary" Size="Compact" Text="Back up"
                                                     Click="BackupRating_OnClick" />
                            <components:ActionButton x:Name="ImportRatingButton" Tone="Secondary" Size="Compact" Text="Import"
                                                     Click="ImportRating_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock x:Name="BackupResultText" Classes="TinyText BackupStatus" TextWrapping="Wrap" TextAlignment="Center"
                       IsVisible="False" />
            <Border Classes="SettingsBottomSpacer" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
