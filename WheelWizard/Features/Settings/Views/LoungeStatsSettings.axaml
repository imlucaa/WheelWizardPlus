<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             mc:Ignorable="d" d:DesignWidth="444" d:DesignHeight="716"
             x:Class="WheelWizard.Settings.Views.LoungeStatsSettings">
    <UserControl.Styles>
        <!-- Sliders follow the launcher accent: a slim neutral track, accent fill, light knob. -->
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="Slider /template/ Border#TrackBackground">
            <Setter Property="Background" Value="{DynamicResource Neutral700}" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton /template/ Border#TrackBackground">
            <Setter Property="Background" Value="{DynamicResource Brand400}" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource Neutral50}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="0,15,0,0">
        <StackPanel Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <components:FormFieldLabel Text="Lounge stats" VerticalAlignment="Center" />
                <components:Button Grid.Column="1" Text="Refresh now" ButtonSize="Compact"
                                   ToolTip.Tip="Read your stats from RR Lounge now instead of at the next refresh"
                                   Click="Refresh_OnClick" />
            </Grid>
            <!-- A dark stage, so a see-through or HUD look reads like it does over the game. -->
            <Border Background="{DynamicResource Neutral900}" CornerRadius="10" Padding="12" MinHeight="70">
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="170">
                    <ContentControl x:Name="PreviewHost" />
                </Viewbox>
            </Border>
            <TextBlock x:Name="StatusText" Classes="TinyText" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel Spacing="10">
                <StackPanel x:Name="OptionsHost" Spacing="10" />

                <Border Classes="SettingsBlockStyle SettingsRowStyle">
                    <StackPanel Spacing="4" Margin="0,6">
                        <components:FormFieldLabel Text="OBS link" />
                        <SelectableTextBlock x:Name="LinkText" Classes="TinyText" TextWrapping="Wrap" />
                        <TextBlock Classes="TinyText" Foreground="{DynamicResource Neutral400}"
                                   Text="Add it to OBS as a Browser source, 1920 by 1080. It follows these settings." />
                    </StackPanel>
                </Border>

                <Border Classes="SettingsBottomSpacer" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="4,10,4,6">
            <components:Button Text="Reset" ButtonSize="Compact" Click="Reset_OnClick" />
            <components:Button Grid.Column="1" Text="Race HUD look" ButtonSize="Compact" Click="CompactHud_OnClick" />
            <components:Button Grid.Column="3" x:Name="WindowButton" Text="Open as window" Click="OpenWindow_OnClick" />
            <components:Button Grid.Column="4" Text="Copy link" Click="Copy_OnClick" />
        </Grid>
    </Grid>
</UserControl>
