<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             mc:Ignorable="d" d:DesignWidth="444" d:DesignHeight="716"
             x:Class="WheelWizard.Settings.Views.FriendCodeSettings">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,15,0,0" Spacing="8">
            <components:FormFieldLabel Text="Friend codes" />

            <!-- Which save, and which license on it -->
            <Border Classes="SettingsBlockStyle SettingsRowStyle">
                <StackPanel Spacing="12" Margin="0,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <components:FormFieldLabel Text="Save region" />
                            <TextBlock Classes="TinyText" Text="Your game disc's region" />
                        </StackPanel>
                        <components:Dropdown x:Name="RegionPicker" Grid.Column="1" Width="150" ZIndex="2" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Neutral700}" Opacity="0.6" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <components:FormFieldLabel Text="License" VerticalAlignment="Center" />
                        <components:Button Grid.Column="1" x:Name="ExportLicenseButton" Text="Export" ButtonSize="Compact"
                                           ToolTip.Tip="Save the selected license as a .rkp file"
                                           Click="ExportLicense_OnClick" />
                        <components:Button Grid.Column="2" x:Name="ExportAllButton" Text="Export all" ButtonSize="Compact"
                                           ToolTip.Tip="Save every license of this save as .rkp files in a folder you pick"
                                           Click="ExportAll_OnClick" />
                        <components:Button Grid.Column="3" x:Name="ImportLicenseButton" Text="Import" ButtonSize="Compact"
                                           ToolTip.Tip="Put a license from a .rkp file, an earlier save or a save file into this save"
                                           Click="ImportLicense_OnClick" />
                    </Grid>
                    <UniformGrid x:Name="LicenseList" Columns="2" Margin="-3,-6,-3,0" />
                    <TextBlock x:Name="LicenseNote" Classes="TinyText" TextWrapping="Wrap" IsVisible="False" />
                    <!-- The ids of the license picked above: what a duplicate checker would look at. -->
                    <Grid x:Name="IdStatusRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
                        <TextBlock x:Name="IdStatusText" Classes="TinyText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <components:Button Grid.Column="1" x:Name="FixIdsButton" Text="Fix IDs" ButtonSize="Compact"
                                           ToolTip.Tip="Give this license new pseudo and authentic IDs, and keep its friend code"
                                           Click="FixIds_OnClick" IsVisible="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Check and replace -->
            <Border Classes="SettingsBlockStyle SettingsRowStyle">
                <StackPanel Spacing="10" Margin="0,8">
                    <components:FormFieldLabel Text="New friend code" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <components:InputField x:Name="CodeInput" Placeholder="Friend code or profile ID"
                                               Variant="Bordered" KeyDown="CodeInput_OnKeyDown" />
                        <components:Button Grid.Column="1" x:Name="CheckButton" Text="Check" Click="Check_OnClick" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Classes="TinyText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Also search the code on the Retro Rewind Discord." />
                        <components:Button Grid.Column="1" Text="Database" ButtonSize="Compact" Click="Database_OnClick" />
                        <components:Button Grid.Column="2" Text="Godtool" ButtonSize="Compact" Click="Godtool_OnClick" />
                    </Grid>
                    <StackPanel x:Name="ResultPanel" Spacing="3" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <SelectableTextBlock x:Name="ResultCode" FontWeight="SemiBold" TextWrapping="Wrap"
                                                 VerticalAlignment="Center" />
                            <components:Button Grid.Column="1" x:Name="CopyIdButton" Text="Copy ID" ButtonSize="Compact"
                                               IsVisible="False" Click="CopyId_OnClick" />
                        </Grid>
                        <TextBlock x:Name="ResultDetail" Classes="TinyText" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultVerdict" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="ApplyPanel" Spacing="8" IsVisible="False">
                        <!-- One more check before taking a code: the community player list has players who are no longer online. -->
                        <Grid x:Name="DatabaseRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock x:Name="DatabaseText" Classes="TinyText" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <components:Button Grid.Column="1" x:Name="DatabaseSearchButton" Text="Search database"
                                               ButtonSize="Compact" Click="SearchDatabase_OnClick" />
                        </Grid>
                        <components:ToggleCheckBox x:Name="AckBox" Variant="Checkbox">
                            <TextBlock Text="Nobody else uses this code." />
                        </components:ToggleCheckBox>
                        <components:Button x:Name="ApplyButton" Text="Replace" HorizontalAlignment="Stretch"
                                           Click="Apply_OnClick" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Undo the last code change, and every earlier one in a popup. Save backups live in the Backup tab. -->
            <Border x:Name="UndoCard" Classes="SettingsBlockStyle SettingsRowStyle" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,6">
                    <TextBlock x:Name="UndoText" Classes="TinyText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <components:Button Grid.Column="1" x:Name="HistoryButton" Text="History" ButtonSize="Compact"
                                       Click="History_OnClick" />
                    <components:Button Grid.Column="2" x:Name="UndoButton" Text="Undo last change" ButtonSize="Compact"
                                       Click="Undo_OnClick" />
                </Grid>
            </Border>

            <Border Classes="SettingsBottomSpacer" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
