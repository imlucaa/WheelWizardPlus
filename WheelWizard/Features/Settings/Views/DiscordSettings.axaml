<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             mc:Ignorable="d" d:DesignWidth="444" d:DesignHeight="716"
             x:Class="WheelWizard.Settings.Views.DiscordSettings">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,15,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <components:FormFieldLabel Text="Discord RPC" VerticalAlignment="Center" />
                <components:SegmentedControl Grid.Column="1" x:Name="ModeToggle" Variant="Light" HasBorder="False"
                                             SelectionChanged="Mode_OnChanged">
                    <components:SegmentOption Text="Off" Padding="14,6" />
                    <components:SegmentOption Text="Default" Padding="14,6" />
                    <components:SegmentOption Text="Custom" Padding="14,6" />
                </components:SegmentedControl>
            </Grid>
            <TextBlock x:Name="ModeNote" Classes="TinyText" TextWrapping="Wrap" Margin="2,0,0,10" />

            <StackPanel Spacing="4">
                <Border x:Name="LiveRow" Classes="SettingsBlockStyle SettingsRowStyle SettingsRowTop">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                        <StackPanel Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                            <components:FormFieldLabel Text="Live game info" />
                            <TextBlock Classes="TinyText" TextWrapping="Wrap"
                                       Text="Show the menu, track and players." />
                        </StackPanel>
                        <components:ToggleCheckBox Grid.Column="1" x:Name="LiveInfoToggle" Variant="Switch"
                                                   VerticalAlignment="Center" Click="LiveInfo_OnClick" />
                    </Grid>
                </Border>

                <Border x:Name="PlayerRow" Classes="SettingsBlockStyle SettingsRowStyle SettingsRowMiddle">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                        <StackPanel Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                            <components:FormFieldLabel Text="View Player button" />
                            <TextBlock Classes="TinyText" TextWrapping="Wrap"
                                       Text="Opens your page on the rwfc.net leaderboard." />
                        </StackPanel>
                        <components:ToggleCheckBox Grid.Column="1" x:Name="PlayerButtonToggle" Variant="Switch"
                                                   VerticalAlignment="Center" Click="PlayerButton_OnClick" />
                    </Grid>
                </Border>

                <Border x:Name="RoomRow" Classes="SettingsBlockStyle SettingsRowStyle SettingsRowMiddle">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                        <StackPanel Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                            <components:FormFieldLabel Text="View Room button" />
                            <TextBlock Classes="TinyText" TextWrapping="Wrap"
                                       Text="Opens your room in the launcher, for friends who have it." />
                        </StackPanel>
                        <components:ToggleCheckBox Grid.Column="1" x:Name="RoomButtonToggle" Variant="Switch"
                                                   VerticalAlignment="Center" Click="RoomButton_OnClick" />
                    </Grid>
                </Border>

                <Border x:Name="SetupBlock" Classes="SettingsBlockStyle SettingsRowStyle SettingsRowBottom">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                        <StackPanel Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                            <components:FormFieldLabel Text="Your setup" />
                            <TextBlock x:Name="SummaryText" Classes="TinyText" TextWrapping="Wrap" />
                        </StackPanel>
                        <components:Button Grid.Column="1" x:Name="SetupButton" Text="Change" ButtonSize="Compact"
                                           VerticalAlignment="Center" Click="Setup_OnClick" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- The buttons first, and what they find below them across the whole width. -->
            <StackPanel Margin="0,12,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <components:Button x:Name="PreviewButton" Text="Preview" Click="Preview_OnClick" />
                    <components:Button x:Name="CheckButton" Text="Check setup" Click="Check_OnClick" />
                </StackPanel>
                <TextBlock x:Name="CheckText" Classes="TinyText" TextWrapping="Wrap" Margin="4,0" IsVisible="False" />
                <TextBlock x:Name="ResultText" Classes="TinyText" TextWrapping="Wrap" Margin="4,0" IsVisible="False" />
            </StackPanel>
            <Border Classes="SettingsBottomSpacer" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
