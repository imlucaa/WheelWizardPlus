<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="656" d:DesignHeight="876"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             x:Class="WheelWizard.RrRooms.Views.RoomsPage"
             x:DataType="rooms:RoomsPage"
        xmlns:rooms="clr-namespace:WheelWizard.RrRooms.Views"
        xmlns:communityControls="clr-namespace:WheelWizard.WheelWizardData.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
            <TextBlock Text="{loc:T page_title.rooms}" Classes="PageTitleText" />
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,0,0"
                    ToolTip.Tip="{loc:T hover.rooms_page_disclaimer}"
                    ToolTip.Placement="Top" ToolTip.ShowDelay="20"
                    Width="18" Height="18">
                <PathIcon Foreground="{StaticResource TitleIconColor}" Margin="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Data="{StaticResource InfoTip}" />
            </Border>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="7,10,7,4">
            <components:Button x:Name="RoomsSearchButton" Text="{loc:T action.search}" Margin="3,3"
                               IconData="{StaticResource Search}" Variant="Default" ButtonSize="Compact"
                               HorizontalAlignment="Stretch" Click="RoomsSearchButton_OnClick" ToolTip.Tip="Search rooms" />
            <components:Button x:Name="RoomsFriendsButton" Text="Friends" Margin="3,3"
                               IconData="{StaticResource Friends}" Variant="Default" ButtonSize="Compact"
                               HorizontalAlignment="Stretch" Click="RoomsFriendsButton_OnClick" ToolTip.Tip="Only rooms with your friends" />
            <components:Button x:Name="RoomsVrFilterButton" Text="{loc:T action.filter_vr}" Margin="3,3"
                               IconData="{StaticResource Chart}" Variant="Default" ButtonSize="Compact"
                               HorizontalAlignment="Stretch" Click="RoomsVrFilterButton_OnClick" ToolTip.Tip="Set VR filters" />
            <components:Button x:Name="RoomsSortButton" Text="{loc:T action.sort}" Margin="3,3"
                               IconData="{StaticResource ArrowSwap}" Variant="Default" ButtonSize="Compact"
                               HorizontalAlignment="Stretch" Click="RoomsSortButton_OnClick" ToolTip.Tip="Choose room sort" />
        </UniformGrid>

        <components:EmptyPageInfo Grid.Row="2" x:Name="EmptyRoomsView"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Title="{loc:T empty_content.no_rooms_title}"
                                  BodyText="{loc:T empty_content.no_rooms}" />


        <Grid Grid.Row="2" RowDefinitions="*, 16*" Margin="10,0" x:Name="RoomsListViewContainer">
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,4">
                    <components:FormFieldLabel Text="{loc:T list_title.rooms}" />
                    <communityControls:CommunityCountBadge Text="0" x:Name="RoomsListItemCount" />
                </StackPanel>
                <Border Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom" />

            </Grid>

            <ListBox x:Name="RoomsListBox" SelectionMode="Single" Padding="0" ItemsSource="{Binding Rooms}"
                     Background="Transparent" BorderThickness="0" Grid.Row="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="RoomsView_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="BoxItemBackground" Padding="12,10">
                            <Grid ColumnDefinitions="14,*,84" RowDefinitions="Auto,Auto" ColumnSpacing="9">
                                <Border Width="5" Height="38" CornerRadius="3" Grid.Column="0" Grid.RowSpan="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource Primary300}"
                                        IsVisible="{Binding IsPublic}" />
                                <Border Width="5" Height="38" CornerRadius="3" Grid.Column="0" Grid.RowSpan="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource Primary300}"
                                        IsVisible="{Binding IsPublic, Converter={x:Static BoolConverters.Not}}"
                                        ToolTip.Tip="Private room" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                    <TextBlock Padding="0,1"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Neutral100}"
                                                VerticalAlignment="Center">
                                        <Run Text="{Binding DisplayGameMode}" /><Run Text="&#8201;" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Id}" FontSize="11" Classes="TinyText"
                                                TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <!-- A player you flagged is in this room. -->
                                    <Border IsVisible="{Binding HasFlags}" CornerRadius="4" Padding="5,1"
                                            Background="{Binding FlagColor}" VerticalAlignment="Center"
                                            ToolTip.Tip="Someone you flagged is in this room">
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#141414">
                                            <Run Text="⚑ " /><Run Text="{Binding FlagSummary}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                    <PathIcon Data="{StaticResource Road}" Width="11" Height="11"
                                              Foreground="{DynamicResource BodyTextColor}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TrackDisplay}" FontSize="12"
                                               Foreground="{DynamicResource Neutral300}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>

                                <Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource Neutral800}"
                                        CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{Binding AverageVrDisplay}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource Primary300}" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{loc:T text.room_avg_vr}" FontSize="10" Foreground="{DynamicResource Neutral300}" />
                                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource Neutral500}" />
                                            <PathIcon Data="{StaticResource UserCouple}" Width="9" Height="9"
                                                      Foreground="{DynamicResource Neutral300}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PlayerCount}" FontSize="10"
                                                       Foreground="{DynamicResource Neutral300}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border.Styles>
                                <Style Selector="ListBoxItem Border.BoxItemBackground PathIcon.RoadIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource Neutral500}" />
                                </Style>
                                <Style Selector="ListBoxItem Border.BoxItemBackground:pointerover PathIcon.RoadIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource Neutral400}" />
                                </Style>
                            </Border.Styles>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>


        <Grid Grid.Row="2" RowDefinitions="*, 16*" Margin="10,0" x:Name="PlayerListViewContainer" IsVisible="False">
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,6">
                    <components:FormFieldLabel Text="{loc:T list_title.players}" />
                    <communityControls:CommunityCountBadge Text="0" x:Name="PlayerListItemCount" />
                </StackPanel>
                <Border Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom" />

            </Grid>

            <ListBox Grid.Row="1" SelectionMode="Single" BorderThickness="0"
                     Padding="0" Margin="0" Background="Transparent" ItemsSource="{Binding Players}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="PlayerView_SelectionChanged">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <rooms:PlayerListItem
                            UserName="{Binding Name}"
                            FriendCode="{Binding FriendCode}"
                            Vr="{Binding VrDisplay}"
                            Mii="{Binding FirstMii}"
                            IsOpenHost="{Binding IsOpenHost}"
                            HasBadges="{Binding HasBadges}"
                            IsTopPlayer="{Binding IsTopLeaderboardPlayer}"
                            TopLabel="{Binding TopLabel}"
                            FlagNote="{Binding FlagNote}"
                            FlagBrush="{Binding FlagColor}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
