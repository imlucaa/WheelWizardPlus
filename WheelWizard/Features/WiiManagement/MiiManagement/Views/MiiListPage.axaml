<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:behaviorComponent="clr-namespace:WheelWizard.MiiImages.Views"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             mc:Ignorable="d" d:DesignWidth="456" d:DesignHeight="776"
              x:Class="WheelWizard.WiiManagement.MiiManagement.Views.MiiListPage"
        xmlns:miis="clr-namespace:WheelWizard.WiiManagement.MiiManagement.Views">
    <UserControl.Styles>
        <Style Selector="TextBlock.OnlineMiiFriendCode:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Neutral50}" />
        </Style>
        <Style Selector="Border.MiiModeSwitcherCard">
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style Selector="components|Button.MiiModeTab">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherPanelBrush}" />
        </Style>
        <Style Selector="components|Button.MiiModeTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
        </Style>
        <Style Selector="components|Button.MiiModeTab:pressed">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
        </Style>
        <Style Selector="components|Button.MiiHeaderActionButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherPanelBrush}" />
        </Style>
        <Style Selector="components|Button.MiiHeaderActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
        </Style>
        <Style Selector="components|Button.MiiHeaderActionButton:pressed">
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
        </Style>
        <Style Selector="components|Button.MiiTranslucentButton">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
        </Style>
        <Style Selector="TextBlock.MiiSectionCaption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Neutral400}" />
        </Style>
        <Style Selector="Border.MiiDownloadCard">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <!-- Theme accent: every surface, border and button on this page follows the launcher accent color. -->
        <Style Selector="Border.MiiModeSwitcherCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.MiiDownloadCard">
            <Setter Property="Background" Value="{DynamicResource Neutral900}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.MiiDownloadCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource Neutral700}" />
        </Style>
        <!-- Buttons use the same dark panel fill as the Patches "Browse" button; no outlines. -->
        <Style Selector="components|ActionButton[Tone=Secondary], components|Button.MiiModeTab, components|Button.MiiHeaderActionButton, components|Button.MiiTranslucentButton">
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Neutral100}" />
        </Style>
        <Style Selector="components|ActionButton[Tone=Secondary]:pointerover, components|Button.MiiModeTab:pointerover, components|Button.MiiHeaderActionButton:pointerover, components|Button.MiiTranslucentButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="components|ActionButton[Tone=Secondary]:pressed, components|Button.MiiModeTab:pressed, components|Button.MiiHeaderActionButton:pressed, components|Button.MiiTranslucentButton:pressed">
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
        </Style>
        <Style Selector="components|Button.MiiHeaderActionButton.Active">
            <Setter Property="Foreground" Value="{DynamicResource Neutral50}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="components|Button.MiiModeTab.Active">
            <Setter Property="Foreground" Value="{DynamicResource Neutral50}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Drag to reorder: the held tile lifts and fades, the tile under it shrinks to show where it will land. -->
        <Style Selector="miis|MiiBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="miis|MiiBlock.Dragging">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>
        <Style Selector="miis|MiiBlock.DropTarget">
            <Setter Property="RenderTransform" Value="scale(0.9)" />
        </Style>
        <!-- Discover tiles: the selected one is shown with a lighter fill instead of a colored outline. -->
        <Style Selector="miis|MiiBlock.DiscoverTile[IsChecked=True] /template/ Border#PART_MainBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Neutral700}" />
        </Style>
        <Style Selector="miis|MiiBlock.DiscoverTile:pointerover /template/ Border#PART_MainBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="miis|MiiBlock.DiscoverTile:pointerover[IsChecked=True] /template/ Border#PART_MainBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Neutral700}" />
        </Style>
    </UserControl.Styles>
    <Grid x:Name="CompleteGrid" x:CompileBindings="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <!-- This is the total height as the (Title + infoSection) - (padding) -->
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Same width as the content below it, so the title lines up with the tabs and the buttons with their right edge. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MaxWidth="470" Margin="8,0" HorizontalAlignment="Stretch">
            <StackPanel x:Name="MiiPageTitle" Orientation="Horizontal" ClipToBounds="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                <TextBlock Text="{loc:T page_title.my_miis}"
                           Classes="PageTitleText" />
                <components:StatusBadge Height="24" Padding="8,3" Text="0"
                                     x:Name="ListItemCount"
                                     VerticalAlignment="Center" />
                <components:StatusBadge x:Name="ActiveTagLabel" Height="24" Padding="8,3" Text=""
                                        IsVisible="False" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,6,10"
                        Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding IsVisible, ElementName=VisibleWhenDb}">
                <components:ActionButton Text="" Click="FavMii_OnClick" x:Name="FavoriteMiiButton"
                                   Tone="Secondary"
                                   ToolTip.ShowDelay="0" ToolTip.Placement="Top">
                    <components:ActionButton.Styles>
                        <Style Selector="components|ActionButton">
                            <Setter Property="IconData" Value="{StaticResource StarIcon}"/>
                            <Setter Property="ToolTip.Tip" Value="{loc:T action.favorite}"/>
                        </Style>
                        <Style Selector="components|ActionButton.UnFav">
                            <Setter Property="IconData" Value="{StaticResource EmptyStarIcon}"/>
                            <Setter Property="ToolTip.Tip" Value="{loc:T action.unfavorite}"/>
                        </Style>
                    </components:ActionButton.Styles>
                </components:ActionButton>
                <components:ActionButton Text="" Click="EditMii_OnClick" x:Name="EditMiisButton"
                                   IconData="{StaticResource Pen}"
                                   Tone="Secondary" IsVisible="False"
                                   ToolTip.ShowDelay="0" ToolTip.Placement="Top"
                                   ToolTip.Tip="{loc:T action.edit}" />
                <components:ActionButton Text="" Click="DuplicateMii_OnClick" x:Name="DuplicateMiisButton"
                                   IconData="{StaticResource Duplicate}"
                                   Tone="Secondary" IsVisible="False"
                                   ToolTip.ShowDelay="0" ToolTip.Placement="Top"
                                   ToolTip.Tip="{loc:T action.duplicate}" />
                <components:ActionButton Text="" Click="ExportMii_OnClick" x:Name="ExportMiisButton"
                                   IconData="{StaticResource FileExport}"
                                   Tone="Secondary" IsVisible="False"
                                   ToolTip.ShowDelay="0" ToolTip.Placement="Top"
                                   ToolTip.Tip="{loc:T action.export}" />
                <components:ActionButton Text="" Click="DeleteMii_OnClick" x:Name="DeleteMiisButton"
                                   IconData="{StaticResource Trash}"
                                   Tone="Danger" IsVisible="False"
                                   ToolTip.ShowDelay="0" ToolTip.Placement="Top"
                                   ToolTip.Tip="{loc:T action.delete}" />
            </StackPanel>
        </Grid>
        <components:EmptyPageInfo Grid.Row="1" x:Name="VisibleWhenNoDb"
                                  HorizontalAlignment="Center" IsVisible="False"
                                  Title="{loc:T empty_content.no_miis_title}"
                                  BodyText="{loc:T empty_content.no_miis}" />

        <Grid x:Name="VisibleWhenDb" Grid.Row="1" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="8,8,8,0" Spacing="10"
                        MaxWidth="470" HorizontalAlignment="Stretch">
                <Border Classes="MiiModeSwitcherCard">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <components:Button Grid.Column="0"
                                               x:Name="MyMiisTabButton"
                                               Classes="MiiModeTab MiiTranslucentButton"
                                                Text="{loc:T mii.my_miis}"
                                               Click="MyMiisTab_OnClick" />
                            <components:Button Grid.Column="1"
                                               x:Name="OnlineMiisTabButton"
                                               Classes="MiiModeTab MiiTranslucentButton"
                                                Text="{loc:T mii.downloader}"
                                               Click="OnlineMiisTab_OnClick" />
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    x:Name="SavedMiiFilterPanel"
                                    IsVisible="False"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                            <components:Button Text="Tags"
                                               Click="TagsButton_OnClick"
                                               x:Name="TagsButton"
                                               Classes="MiiHeaderActionButton"
                                               Width="52"
                                               ToolTip.Tip="Filter by tag" />
                            <components:Button Text=""
                                               Click="ImportMii_OnClick"
                                               x:Name="HeaderImportMiiButton"
                                               Classes="MiiHeaderActionButton"
                                               IconData="{StaticResource FileImport}"
                                               Variant="Default"
                                               ToolTip.ShowDelay="0"
                                               ToolTip.Placement="Top"
                                               ToolTip.Tip="{loc:T action.import}" />
                            <components:Button Text=""
                                               Click="SearchSavedMiiButton_OnClick"
                                               x:Name="SearchSavedMiiButton"
                                               Classes="MiiHeaderActionButton"
                                               IconData="{StaticResource Search}"
                                               Variant="Default"
                                               ToolTip.ShowDelay="0"
                                               ToolTip.Placement="Top"
                                                ToolTip.Tip="{loc:T mii.filter_saved}" />
                        </StackPanel>

                        <components:Button Grid.Column="1"
                                           x:Name="SearchOnlineMiiButton"
                                           Text=""
                                           Classes="MiiHeaderActionButton"
                                           HorizontalAlignment="Right"
                                           IsVisible="False"
                                           IconData="{StaticResource Search}"
                                           Variant="Default"
                                           Click="SearchFriendCode_OnClick"
                                            ToolTip.Tip="{loc:T mii.search_rwfc}" />
                    </Grid>
                </Border>
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="MiiList" SelectionMode="Single" BorderThickness="0"
                     Background="Transparent" Padding="0" ItemsSource="{Binding MiiRows}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <miis:MiiBlock Width="108" Height="108" Margin="6,8"
                                                                Mii="{Binding Mii}"
                                                                GroupName="{Binding SelectionGroup}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Click="MiiBlock_OnClick">
                                        <miis:MiiBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding FavoriteActionHeader}"
                                                          CommandParameter="{Binding}" Click="FavoriteContextMenu_OnClick"
                                                          IsEnabled="{Binding HasMii}" />
                                                <MenuItem Header="Tags..."
                                                          CommandParameter="{Binding}" Click="TagContextMenu_OnClick"
                                                          IsEnabled="{Binding HasMii}" />
                                                <MenuItem Header="{loc:T action.edit}"
                                                          CommandParameter="{Binding}" Click="EditContextMenu_OnClick"
                                                          IsEnabled="{Binding HasMii}" />
                                                <MenuItem Header="Duplicate"
                                                          CommandParameter="{Binding}" Click="DuplicateContextMenu_OnClick"
                                                          IsEnabled="{Binding HasMii}" />
                                                <MenuItem Header="{loc:T action.export}"
                                                          CommandParameter="{Binding}" Click="ExportContextMenu_OnClick"
                                                          IsEnabled="{Binding HasMii}" />
                                                <MenuItem Header="{loc:T action.delete}"
                                                          CommandParameter="{Binding}" Click="DeleteContextMenu_OnClick"
                                                          IsEnabled="{Binding HasMii}" />
                                            </ContextMenu>
                                        </miis:MiiBlock.ContextMenu>
                                    </miis:MiiBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1" x:Name="OnlineMiiPanel" IsVisible="False" Margin="10,6,10,10"
                  RowDefinitions="Auto,*">
                <!-- Preview: one Mii tile with the player's details beside it. -->
                <Grid MaxWidth="440" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                      ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <!-- The editor's live 3D Mii: drag to turn it, it follows the cursor and reacts when clicked. -->
                    <components:Button x:Name="PreviousOnlineMiiButton" Text="" Width="32" Height="32" MinHeight="32" Padding="0"
                                       Grid.Column="0" VerticalAlignment="Center"
                                       Classes="MiiTranslucentButton"
                                       IconData="{StaticResource ArrowLeft}"
                                       Click="PreviousOnlineMii_OnClick" IsEnabled="False"
                                       ToolTip.Tip="Previous player" />
                    <Border Grid.Column="1" Width="144" Height="172" ClipToBounds="True" CornerRadius="16" VerticalAlignment="Center"
                            Background="{DynamicResource Neutral900}" BoxShadow="0 6 22 0 #55000000">
                        <!-- Laid out much taller than the frame and clipped: the Mii scales with the stage height, so this zooms in on the head. -->
                        <Grid>
                            <Grid x:Name="OnlineMiiStageHost" />
                            <!-- Soft fade where the shoulders are cut off. -->
                            <Border Height="34" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="{DynamicResource Neutral900}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- The position sits under the Mii. -->
                            <TextBlock x:Name="OnlineMiiMatchIndex" Classes="TinyText" IsHitTestVisible="False"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                                       TextAlignment="Center" Foreground="{DynamicResource Neutral300}" />
                        </Grid>
                    </Border>
                    <components:Button x:Name="NextOnlineMiiButton" Text="" Width="32" Height="32" MinHeight="32" Padding="0"
                                       Grid.Column="2" VerticalAlignment="Center"
                                       Classes="MiiTranslucentButton"
                                       IconData="{StaticResource ArrowRight}"
                                       Click="NextOnlineMii_OnClick" IsEnabled="False"
                                       ToolTip.Tip="Next player" />
                    <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock x:Name="OnlineMiiName" Text="Select a player to preview their Mii"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="OnlineMiiFriendCode" Classes="TinyText OnlineMiiFriendCode" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{DynamicResource Neutral400}" Cursor="Hand" ToolTip.Tip="Click to copy"
                                   PointerPressed="OnlineMiiFriendCode_OnPointerPressed" />
                        <TextBlock x:Name="OnlineMiiLookupStatus" Classes="TinyText" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Neutral400}" />
                        <components:Button x:Name="ImportOnlineMiiButton" Text="{loc:T action.import}"
                                           Classes="MiiTranslucentButton"
                                           IconData="{StaticResource FileImport}"
                                           Height="38" MinHeight="38" Padding="12,0" Margin="0,10,0,0"
                                           HorizontalAlignment="Stretch"
                                           Click="ImportOnlineMii_OnClick" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="2,2,2,8" MaxWidth="372" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="36,*,36" Margin="6,0,6,0">
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Discover Miis" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="SuggestedMiisStatus" Classes="TinyText" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource Neutral400}"
                                           Text="Open Mii Downloader to load random Miis." />
                            </StackPanel>
                            <components:Button Grid.Column="2" x:Name="RefreshSuggestedMiisButton" Text=""
                                               Width="36" Height="36" MinHeight="36" Padding="0" VerticalAlignment="Center"
                                               Classes="MiiTranslucentButton"
                                               IconData="{StaticResource Refresh}"
                                               ToolTip.Tip="Show different Miis"
                                               Click="RefreshSuggestedMiis_OnClick" />
                        </Grid>

                        <ItemsControl x:Name="SuggestedMiisList" ItemsSource="{Binding SuggestedOnlineMiis}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <miis:MiiBlock Classes="DiscoverTile" Width="108" Height="108" Margin="6,8"
                                                   Mii="{Binding Mii}" GroupName="DiscoverMiis"
                                                   Click="SuggestedMiiBlock_OnClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
